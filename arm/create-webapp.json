{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "appServicePlanName": {
            "type": "string",
            "defaultValue": "[format('libras-appserviceplan-{0}', uniqueString(resourceGroup().id))]",
            "metadata": {
                "description": "Name of the App Service Plan."
            }
        },
        "appServicePlanSku": {
            "type": "string",
            "defaultValue": "B1",
            "allowedValues": [
                "F1",
                "B1",
                "B2",
                "B3",
                "S1",
                "S2",
                "S3",
                "P1v2",
                "P2v2",
                "P3v2"
            ],
            "metadata": {
                "description": "SKU of the App Service Plan. Examples: F1 (Free), B1-B3 (Basic), S1-S3 (Standard), P1v2-P3v2 (Premium)."
            }
        },
        "appServicePlanTier": {
            "type": "string",
            "defaultValue": "Free",
            "metadata": {
                "description": "Pricing tier of the App Service Plan."
            }
        },
        "appServicePlanSize": {
            "type": "string",
            "defaultValue": "F1",
            "metadata": {
                "description": "Size of the App Service Plan instance."
            }
        },
        "webAppName": {
            "type": "string",
            "defaultValue": "[format('libras-webapp-{0}', newGuid())]",
            "metadata": {
                "description": "Web app name"
            }
        },
        "webAppRuntimeStack": {
            "type": "string",
            "defaultValue": "PYTHON|3.9",
            "allowedValues": [
              "DOTNETCORE|6.0",
              "DOTNETCORE|3.1",
              "NODE|14-lts",
              "NODE|16-lts",
              "PYTHON|3.9",
              "JAVA|11-java11",
              "PHP|7.4",
              "RUBY|2.7"
            ],
            "metadata": {
              "description": "Especifica o runtime stack do WebApp"
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location for all resources."
            }
        }
    },
    "resources": [
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2021-02-01",
            "name": "[parameters('webAppName')]",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
            ],
            "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
                "siteConfig": {
                    "linuxFxVersion": "[parameters('webAppRuntimeStack')]"
                },
                "httpsOnly": true
            }
        },
        {
            "type": "Microsoft.Web/serverfarms",
            "apiVersion": "2021-02-01",
            "name": "[parameters('appServicePlanName')]",
            "location": "[resourceGroup().location]",
            "kind": "app,linux",
            "sku": {
                "name": "[parameters('appServicePlanSku')]",
                "tier": "[parameters('appServicePlanTier')]",
                "size": "[parameters('appServicePlanSize')]"
            },
            "properties": {
                "reserved": true
            }
        }
    ]
}